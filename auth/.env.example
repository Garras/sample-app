# cp .env.example .env, then fill in.

# Host port to publish on. Must agree with BETTER_AUTH_URL below.
AUTH_PORT=3100

# Where Better Auth matches request paths. Include the serving prefix here, NOT in
# BETTER_AUTH_URL - routing uses this value alone, while URL generation uses the other.
#   standalone            -> /api/auth
#   behind the gateway    -> /auth/api/auth
BETTER_AUTH_BASE_PATH=/api/auth

# Must be the address the browser uses - it is what ends up in the discovery document.
# Origin only - no path, even when served under one.
BETTER_AUTH_URL=http://localhost:3100

# openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE-ME

# Comma-separated origins allowed to call the auth API.
TRUSTED_ORIGINS=http://localhost:3100
